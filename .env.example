# CityPulse environment variables — copy to .env and fill in

# Optional: Google AI Studio key for LLM summaries (P1 feature)
# Leave blank to use template-only summaries (always works without this)
GEMINI_API_KEY=

# Optional: Discord webhook for alerts (P1 feature)
DISCORD_WEBHOOK_URL=

# Optional: Telegram bot token + chat ID for alerts (P1 feature)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# App settings
MODE=live            # live | replay | scenario
LOG_LEVEL=INFO
DEMO_ENABLED=true    # enables ?demo=1 control panel
